# The core scaffold requires no credentials.
#
# Optional stretch integrations may use these later. Keep real values in
# an untracked .env file and never commit them.
ANTHROPIC_API_KEY=
GOOGLE_MAPS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
AGENT_COD_RTO_THRESHOLD=0.50
ORCHESTRATOR_MODEL=claude-sonnet-5
NEGOTIATOR_MODEL=claude-sonnet-5
ADDRESS_MODEL=claude-haiku-4-5
DEALMAKER_MODEL=claude-haiku-4-5

# External services default to simulated backends. Only ANTHROPIC_API_KEY is
# required to run the agent end to end. Set a flag to 1 to go live for that
# service (LIVE_MODE=1 switches all three).
# LIVE_MODE=0
# LIVE_GEOCODE=0
# LIVE_WHATSAPP=0
# LIVE_RAZORPAY=0
